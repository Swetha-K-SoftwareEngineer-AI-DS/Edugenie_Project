# ==========================================
# EduGenie - Environment Configuration
# ==========================================

# 1. Google Gemini API Key (Required for AI features)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Database Configuration (MySQL)
# Standard format: mysql+pymysql://<db_user>:<db_password>@<db_host>:<db_port>/<db_name>
# Example: mysql+pymysql://root:password123@localhost:3306/edugenie_db
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/edugenie_db

# Allow automatic SQLite fallback if MySQL server is not currently reachable
# Set to 'True' for zero-friction local testing or 'False' to require strict MySQL
ALLOW_SQLITE_FALLBACK=True

# 3. Security Settings
SECRET_KEY=edugenie_super_secret_secure_key_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 4. Server Host & Port
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
